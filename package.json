{
  "name": "senvenli-ui-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter site dev",
    "manifests": "UPDATE_MANIFESTS=1 vitest run packages/react/src/manifest",
    "release:check": "pnpm build && pnpm test && pnpm --filter site test && sh scripts/smoke-pack.sh"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "jsdom": "^27.4.0",
    "@testing-library/react": "^16.3.2",
    "ajv": "^8.17.1"
  }
}
