{
  "name": "@senvenli/mcp",
  "version": "0.3.10",
  "description": "MCP server for building with Senvenli UI from AI coding agents: components, examples, docs and themes.",
  "license": "MIT",
  "author": "Senvenli",
  "homepage": "https://design.senvenli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senvenli/Senvenli-UI.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/Senvenli/Senvenli-UI/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-system",
    "ai",
    "agents",
    "react"
  ],
  "type": "module",
  "bin": {
    "senvenli-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "data": "node scripts/build-data.ts",
    "build": "node scripts/build-data.ts && tsc -p tsconfig.json",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@senvenli/tokens": "workspace:^",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
