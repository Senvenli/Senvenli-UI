{
  "$schema": "../../manifest/component.schema.json",
  "kind": "component",
  "family": "layout",
  "status": "alpha",
  "import": "@senvenli/react/layout",
  "name": "toolbar",
  "title": "Toolbar",
  "exports": [
    "Toolbar",
    "ToolbarSpacer",
    "BulkBar"
  ],
  "description": "A row of controls above a list or table; BulkBar shows actions for the selected rows.",
  "keywords": [
    "toolbar",
    "actions",
    "bulk",
    "filters",
    "selection"
  ],
  "usage": {
    "when": [
      "Filters, search and actions above a list.",
      "Actions on selected rows (BulkBar)."
    ],
    "instead": [
      {
        "use": "button-group",
        "when": "Two or three related buttons, not a full row of controls."
      },
      {
        "use": "menu",
        "when": "The actions fit under one button."
      }
    ]
  },
  "a11y": {
    "keyboard": [
      {
        "keys": "Arrow keys",
        "does": "Moves between controls."
      }
    ],
    "builtIn": [
      "One tab stop for the toolbar."
    ],
    "youProvide": [
      "A name for the toolbar."
    ]
  },
  "related": [
    "pagination"
  ],
  "genui": {
    "expose": false
  }
}
