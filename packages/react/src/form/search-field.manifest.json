{
  "$schema": "../../manifest/component.schema.json",
  "kind": "component",
  "family": "form",
  "status": "alpha",
  "import": "@senvenli/react/form",
  "name": "search-field",
  "title": "Search field",
  "exports": [
    "SearchField"
  ],
  "description": "A search input with a clear button and Escape to clear.",
  "keywords": [
    "search",
    "filter",
    "query",
    "find"
  ],
  "usage": {
    "when": [
      "Searching or filtering a list or the app."
    ]
  },
  "a11y": {
    "keyboard": [
      {
        "keys": "Escape",
        "does": "Clears the field."
      },
      {
        "keys": "Enter",
        "does": "Submits the search."
      }
    ],
    "builtIn": [
      "The clear button is named \"Clear\"."
    ],
    "youProvide": [
      "A label or placeholder that lists what can be searched."
    ]
  },
  "related": [
    "text-field"
  ],
  "genui": {
    "expose": true,
    "description": "A search box. Say what can be searched in the label. Emits change.",
    "props": [
      "label",
      "placeholder"
    ],
    "children": "none",
    "events": [
      "change",
      "submit"
    ]
  }
}
