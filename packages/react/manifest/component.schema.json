{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://design.senvenli.com/schema/component.json",
  "title": "Senvenli UI component manifest (hand-written part)",
  "description": "One file per documentation page, beside the source: packages/react/src/<family>/<name>.manifest.json. The build adds props, tokens, strings, quality and source files, and writes packages/react/manifests/<name>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "name",
    "title",
    "family",
    "description",
    "keywords",
    "status",
    "exports",
    "import",
    "usage",
    "a11y"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "component",
        "pattern"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Slug: URL, MCP id, CLI name."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "enum": [
        "action",
        "brand",
        "charts",
        "collection",
        "color",
        "date",
        "display",
        "feedback",
        "form",
        "layout",
        "navigation",
        "overlay",
        "selection"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "One sentence: what it is for."
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "alpha",
        "beta",
        "stable",
        "deprecated"
      ]
    },
    "replacedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "description": "Components documented on this page; the first is the main one."
    },
    "import": {
      "type": "string",
      "pattern": "^@senvenli/react(/[a-z-]+)?$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when"
      ],
      "properties": {
        "when": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "instead": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "use",
              "when"
            ],
            "properties": {
              "use": {
                "type": "string"
              },
              "when": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "do": {
            "type": "string"
          },
          "avoid": {
            "type": "string"
          }
        }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builtIn",
        "youProvide"
      ],
      "properties": {
        "keyboard": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "keys",
              "does"
            ],
            "properties": {
              "keys": {
                "type": "string"
              },
              "does": {
                "type": "string"
              }
            }
          }
        },
        "builtIn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "youProvide": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "genui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expose"
      ],
      "properties": {
        "expose": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "description": "For the model: what it is and when not to use it."
        },
        "props": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([A-Z][A-Za-z0-9]*\\.)?[a-z][A-Za-z0-9]*$"
          },
          "description": "Ordered allow-list. A bare name is a prop of the main export; Export.prop pulls a prop from a part (flattening)."
        },
        "children": {
          "oneOf": [
            {
              "enum": [
                "none",
                "text"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ],
          "description": "\"none\", \"text\", or a list of manifest slugs (\"heading\", \"text\") of components with genui.expose. The slug is also the node `type` in generative UI specs."
        },
        "events": {
          "type": "array",
          "items": {
            "enum": [
              "press",
              "change",
              "submit"
            ]
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "if": {
        "properties": {
          "expose": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "expose",
          "description",
          "props",
          "children"
        ]
      }
    }
  }
}
