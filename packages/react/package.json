{
  "name": "@senvenli/react",
  "version": "0.0.0",
  "description": "Senvenli UI web components (React Aria Components + Tailwind v4).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base.css": "./styles/base.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@senvenli/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "lucide-react": "^1.34.0",
    "react": ">=19",
    "react-aria-components": "^1.21.1",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "1.34.0",
    "react": "^19",
    "react-aria-components": "1.21.1",
    "react-dom": "^19"
  }
}
