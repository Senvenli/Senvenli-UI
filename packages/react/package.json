{
  "name": "@senvenli/react",
  "version": "0.3.1",
  "description": "Senvenli UI web components (React Aria Components + Tailwind v4).",
  "license": "MIT",
  "author": "Senvenli",
  "homepage": "https://design.senvenli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senvenli/Senvenli-UI.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/Senvenli/Senvenli-UI/issues",
  "keywords": [
    "react",
    "design-system",
    "components",
    "react-aria",
    "tailwindcss",
    "accessibility",
    "ui"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./display": {
      "types": "./dist/display/index.d.ts",
      "default": "./dist/display/index.js"
    },
    "./theme.css": "./styles/theme.css",
    "./base.css": "./styles/base.css",
    "./manifests/*": "./manifests/*",
    "./action": {
      "types": "./dist/action/index.d.ts",
      "default": "./dist/action/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "default": "./dist/layout/index.js"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "default": "./dist/feedback/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "default": "./dist/form/index.js"
    },
    "./selection": {
      "types": "./dist/selection/index.d.ts",
      "default": "./dist/selection/index.js"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "default": "./dist/overlay/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "default": "./dist/navigation/index.js"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "default": "./dist/date/index.js"
    },
    "./color": {
      "types": "./dist/color/index.d.ts",
      "default": "./dist/color/index.js"
    },
    "./collection": {
      "types": "./dist/collection/index.d.ts",
      "default": "./dist/collection/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    }
  },
  "files": [
    "dist",
    "manifest",
    "manifests",
    "styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/esm-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@senvenli/tokens": "workspace:^",
    "clsx": "^2.1.1",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "lucide-react": "^1.34.0",
    "react": ">=19",
    "react-aria-components": "^1.21.1",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "1.34.0",
    "react": "^19",
    "react-aria-components": "1.21.1",
    "react-dom": "^19"
  },
  "publishConfig": {
    "access": "public"
  }
}
