      {
        "name": "render",
        "type": "(props: DetailedHTMLProps<LinkWithRequiredHref, HTMLAnchorElement> | React.JSX.IntrinsicElements[Fallback], renderProps: T) => ReactElement",
        "required": false,
        "origin": "aria",
        "description": "Overrides the default DOM element with a custom render function.\nThis allows rendering existing components with built-in styles and behaviors\nsuch as router links, animation libraries, and pre-styled components.\n\nNote: You can check if `'href' in props` in order to tell whether to render an `<a>` element.\n\nRequirements:\n\n- You must render the expected element type (e.g. if `<a>` is expected, you cannot render a\n  `<button>`).\n- Only a single root DOM element can be rendered (no fragments).\n- You must pass through props and ref to the underlying DOM element, merging with your own prop\n  as appropriate."
      },
      {
        "name": "download",
        "type": "string | boolean",
        "required": false,
        "origin": "aria",
        "description": "Causes the browser to download the linked URL. A string may be provided to suggest a file name.\nSee [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a#download)."
      },
      {
        "name": "hrefLang",
        "type": "string",
        "required": false,
        "origin": "aria",
        "description": "Hints at the human language of the linked URL.\nSee[MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a#hreflang).",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "ping",
        "type": "string",
        "required": false,
        "origin": "aria",
        "description": "A space-separated list of URLs to ping when the link is followed. See\n[MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a#ping).",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "referrerPolicy",
        "type": "HTMLAttributeReferrerPolicy",
        "required": false,
        "origin": "aria",
        "description": "How much of the referrer to send when following the link. See\n[MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a#referrerpolicy).",
        "schema": {
          "type": "string",
          "enum": [
            "",
            "no-referrer",
            "no-referrer-when-downgrade",
            "origin",
            "origin-when-cross-origin",
            "same-origin",
            "strict-origin",
            "strict-origin-when-cross-origin",
            "unsafe-url"
          ]
        }
      },
      {
        "name": "href",
        "type": "string",
        "required": true,
        "origin": "own",
        "description": "Where it goes. Rendered as a real `href`, so the link works before (and without) JavaScript.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "variant",
        "type": "ButtonVariant",
        "required": false,
        "origin": "own",
        "default": "\"default\"",
        "description": "Button's look: `primary` for the one main call to action of a view.",
        "schema": {
          "type": "string",
          "enum": [
            "default",
            "link",
            "primary",
            "subtle",
            "danger"
          ]
        }
      },
      {
        "name": "size",
        "type": "ButtonSize",
        "required": false,
        "origin": "own",
        "default": "\"default\"",
        "schema": {
          "type": "string",
          "enum": [
            "default",
            "compact",
            "large"
          ]
        }
      },
      {
        "name": "iconBefore",
        "type": "IconName",
        "required": false,
        "origin": "own",
        "description": "Lucide icon name shown before the label.",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      {
        "name": "iconAfter",
        "type": "IconName",
        "required": false,
        "origin": "own",
        "description": "Lucide icon name shown after the label.",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      {
        "name": "isExternal",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "description": "Link's convention: opens in a new tab with `noopener noreferrer`, shows `arrow-up-right` after the label\n(unless `iconAfter` is set) and tells screen readers it opens a new tab. With `onPress` a plain click\nopens nothing (the app handles it in place), so the arrow and the new-tab words are left out; `target`\nand `rel` stay for the page before JavaScript. Disabled, it opens nothing either: no `target`, `rel` or\nnew-tab words (the arrow stays, as `iconAfter` would).",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "onPress",
        "type": "(event: MouseEvent<HTMLAnchorElement, MouseEvent>) => void",
        "required": false,
        "origin": "own",
        "description": "Optional. Runs on a plain primary click or Enter, and cancels that navigation (`preventDefault`), so the\napp can handle it in place (open a dialog, track and route). A click with Ctrl, Cmd, Shift or Alt, or with\nthe middle button, is left to the browser (new tab, new window, download). Without JavaScript the `href`\nis followed as usual. It receives the click itself, a `React.MouseEvent<HTMLAnchorElement>`, not the\n`PressEvent` Button's `onPress` receives."
      },
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own"
      },
      {
        "name": "iconOnly",
        "type": "false | true",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      }
    ]
