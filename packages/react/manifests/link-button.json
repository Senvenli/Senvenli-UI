{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "action",
  "status": "alpha",
  "import": "@senvenli/react/action",
  "name": "link-button",
  "title": "Link button",
  "exports": [
    "LinkButton"
  ],
  "description": "A link that looks like a button: a call to action that goes to another page.",
  "keywords": [
    "link",
    "button",
    "cta",
    "navigation",
    "href"
  ],
  "usage": {
    "when": [
      "A call to action that navigates: \"Add product\" to /products/new."
    ],
    "instead": [
      {
        "use": "button",
        "when": "The press changes something on this page."
      }
    ]
  },
  "a11y": {
    "keyboard": [
      {
        "keys": "Enter",
        "does": "Follows the link."
      }
    ],
    "builtIn": [
      "Keeps link semantics: role link and a real href that works without JavaScript."
    ],
    "youProvide": [
      "An `aria-label` when it shows only an icon."
    ]
  },
  "related": [
    "button",
    "link"
  ],
  "genui": {
    "expose": true,
    "description": "A button-styled link to another page. Use button instead when nothing navigates.",
    "props": [
      "href",
      "variant",
      "size",
      "iconBefore",
      "iconAfter"
    ],
    "children": "text",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "href": {
          "type": "string",
          "description": "Where it goes. Rendered as a real `href`, so the link works before (and without) JavaScript."
        },
        "variant": {
          "type": "string",
          "enum": [
            "default",
            "link",
            "primary",
            "subtle",
            "danger"
          ],
          "description": "Button's look: `primary` for the one main call to action of a view."
        },
        "size": {
          "type": "string",
          "enum": [
            "default",
            "compact",
            "large"
          ]
        },
        "iconBefore": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Lucide icon name shown before the label."
        },
        "iconAfter": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Lucide icon name shown after the label."
        }
      },
      "required": [
        "href"
      ]
    }
  },
  "source": [
    "src/action/link-button.tsx"
  ],
