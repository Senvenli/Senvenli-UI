{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "overlay",
  "status": "alpha",
  "import": "@senvenli/react/overlay",
  "name": "hover-card",
  "title": "Hover card",
  "exports": [
    "HoverCard"
  ],
  "description": "A preview card that opens when the pointer rests on its trigger or the trigger gets keyboard focus.",
  "keywords": [
    "hover card",
    "preview",
    "popover on hover",
    "profile card"
  ],
  "usage": {
    "when": [
      "A preview of a person or a record behind a link."
    ],
    "instead": [
      {
        "use": "tooltip",
        "when": "A few words about a control."
      },
      {
        "use": "popover",
        "when": "Content people open on purpose with a click."
      }
    ]
  },
  "guidance": [
    {
      "rule": "Supplementary only: the trigger must make sense without the card."
    }
  ],
  "a11y": {
    "builtIn": [
      "Opens after a delay on hover or focus, stays while the pointer is on it, closes with Esc."
    ],
    "youProvide": [
      "A trigger that is a link (or focusable) to the full page."
    ]
  },
  "related": [
    "tooltip",
    "popover"
  ],
  "genui": {
    "expose": false
  },
  "source": [
    "src/overlay/hover-card.tsx"
  ],
  "props": {
    "HoverCard": [
      {
        "name": "trigger",
        "type": "ReactElement<unknown, string | JSXElementConstructor<any>>",
        "required": true,
        "origin": "own",
        "description": "A link (or a focusable element) whose preview the card shows: a person's name, a record reference."
      },
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": true,
        "origin": "own",
        "description": "The preview: an avatar and a line about the person, a record's key fields. Supplementary, never essential."
      },
      {
        "name": "openDelay",
        "type": "number",
        "required": false,
        "origin": "own",
        "default": "500",
        "description": "Before it opens (ms); default 500, so moving across the page does not flash cards.",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "closeDelay",
        "type": "number",
        "required": false,
        "origin": "own",
        "default": "200",
        "description": "Before it closes after the pointer leaves (ms); default 200, enough to reach the card.",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "placement",
        "type": "Placement",
        "required": false,
        "origin": "own",
        "default": "\"bottom\"",
        "schema": {
          "type": "string",
          "enum": [
            "top",
            "bottom",
            "left",
            "right",
            "start",
            "end",
            "bottom left",
            "bottom right",
            "bottom start",
            "bottom end",
            "top left",
            "top right",
            "top start",
            "top end",
            "left top",
            "left bottom",
            "start top",
            "start bottom",
            "right top",
            "right bottom",
            "end top",
            "end bottom"
          ]
        }
      }
    ]
  },
  "tokens": [
    "ds-background-neutral-bold",
    "ds-background-neutral-pressed",
    "ds-background-neutral-subtle-hovered",
    "ds-blanket",
    "ds-border",
    "ds-border-focused",
    "ds-easing-enter",
    "ds-easing-exit",
    "ds-icon-danger",
    "ds-icon-subtle",
    "ds-radius-large",
    "ds-radius-small",
    "ds-radius-xlarge",
    "ds-shadow-overlay",
    "ds-space-050",
    "ds-space-075",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-space-300",
    "ds-surface-overlay",
    "ds-text",
    "ds-text-danger",
    "ds-text-disabled",
    "ds-text-inverse",
    "ds-text-subtle",
    "ds-text-subtlest",
    "font-ds-mono"
  ],
  "strings": [],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
