        "name": "target",
        "type": "\"_self\" | \"_blank\" | \"_parent\" | \"_top\"",
        "required": false,
        "description": "The target attribute specifies a name or a keyword that indicates where to display the response\nthat is received after submitting the form. See\n[MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/form#target).",
        "schema": {
          "type": "string",
          "enum": [
            "_self",
            "_blank",
            "_parent",
            "_top"
          ]
        }
      },
      {
        "name": "render",
        "type": "DOMRenderFunction<\"form\", undefined>",
        "required": false,
        "description": "Overrides the default DOM element with a custom render function.\nThis allows rendering existing components with built-in styles and behaviors\nsuch as router links, animation libraries, and pre-styled components.\n\nRequirements:\n\n- You must render the expected element type (e.g. if `<button>` is expected, you cannot render an\n  `<a>`).\n- Only a single root DOM element can be rendered (no fragments).\n- You must pass through props and ref to the underlying DOM element, merging with your own prop\n  as appropriate."
      },
      {
        "name": "validationBehavior",
        "type": "\"aria\" | \"native\"",
        "required": false,
        "default": "\"aria\"",
        "description": "Whether to use native HTML form validation to prevent form submission\nwhen a field value is missing or invalid, or mark fields as required\nor invalid via ARIA.",
