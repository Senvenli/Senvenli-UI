{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "navigation",
  "status": "alpha",
  "import": "@senvenli/react/navigation",
  "name": "footer",
  "title": "Footer",
  "exports": [
    "Footer"
  ],
  "description": "Closes a public page: the brand, link columns, contact, legal line and an optional language switch.",
  "keywords": [
    "footer",
    "site footer",
    "links",
    "legal"
  ],
  "usage": {
    "when": [
      "The end of every page of a public site."
    ]
  },
  "a11y": {
    "builtIn": [
      "Each column is a navigation named by its title."
    ],
    "youProvide": [
      "A `brandLabel` when the brand alone does not say where it goes."
    ]
  },
  "related": [
    "navbar"
  ],
  "genui": {
    "expose": false
  },
  "source": [
    "src/navigation/footer.tsx"
  ],
  "props": {
    "Footer": [
      {
        "name": "brand",
        "type": "React.ReactNode",
        "required": true,
        "description": "The logo and wordmark (the site's logo and name). It links to `brandHref`."
      },
      {
        "name": "brandHref",
        "type": "string",
        "required": false,
        "default": "\"/\"",
        "description": "Where the brand goes: the home page.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "brandLabel",
        "type": "string",
        "required": false,
        "description": "The brand link's name when the brand alone does not say where it goes (\"Acme home\").",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "about",
        "type": "React.ReactNode",
        "required": false,
        "description": "One line about the product, under the brand."
      },
      {
        "name": "contact",
        "type": "React.ReactNode",
        "required": false,
        "description": "A contact link under the about line (a subtle `Link` to the support address)."
      },
      {
        "name": "columns",
        "type": "readonly FooterColumn[]",
        "required": true,
        "description": "Two to four columns of links.",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "href": {
                      "type": "string"
                    },
                    "isExternal": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "label",
                    "href"
                  ]
                }
              }
            },
            "required": [
              "title",
              "links"
            ]
          }
        }
      },
      {
        "name": "legal",
        "type": "React.ReactNode",
        "required": true,
        "description": "The copyright line (\"© 2026 Acme\"); a platform credit can go here too."
      },
      {
        "name": "languageSwitch",
        "type": "React.ReactNode",
        "required": false,
        "description": "The language switch at the end of the legal row (a subtle compact Button or Menu)."
      },
      {
        "name": "headingLevel",
        "type": "2 | 3 | 4",
        "required": false,
        "default": "2",
        "description": "The column titles' heading level: 2 by default, a level below the page's h1.",
        "schema": {
          "enum": [
            2,
            3,
            4
          ]
        }
      }
    ]
  },
  "tokens": [
    "ds-border",
    "ds-border-focused",
    "ds-radius-medium",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-space-300",
    "ds-space-400",
    "ds-space-500",
    "ds-space-600",
    "ds-surface-sunken",
    "ds-text",
    "ds-text-subtle",
    "ds-text-subtlest"
  ],
  "strings": [],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
