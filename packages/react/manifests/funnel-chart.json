{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "charts",
  "status": "alpha",
  "import": "@senvenli/react/charts",
  "name": "funnel-chart",
  "title": "Funnel chart",
  "exports": [
    "FunnelChart"
  ],
  "description": "Steps of a process with how many reach each one and the conversion between them.",
  "keywords": [
    "funnel-chart",
    "conversion",
    "steps"
  ],
  "usage": {
    "when": [
      "Where people drop out of a flow."
    ],
    "instead": [
      {
        "use": "bar-list",
        "when": "The steps are independent categories, not a sequence people drop out of."
      },
      {
        "use": "stepper",
        "when": "The steps are a flow to complete, not counts to compare."
      }
    ]
  },
  "a11y": {
    "builtIn": [
      "A \"Show as table\" button shows the same data as a table, which screen readers get by default."
    ],
    "youProvide": [
      "A title that says what the figure is."
    ]
  },
  "related": [
    "bar-chart"
  ],
  "genui": {
    "expose": false
  },
  "source": [
    "src/charts/list-charts.tsx"
  ],
  "props": {
    "FunnelChart": [
      {
        "name": "title",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "What the chart shows, over it; leave it out when a card or a heading already says so.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "aria-label",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "Names the chart when it has no visible `title` (a card's heading already says what it shows).",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "period",
        "type": "string",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "isLoading",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "emptyState",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own",
        "description": "Shown instead of the plot when there is no data: an `EmptyState size=\"small\"` or text; \"No data\" by default."
      },
      {
        "name": "steps",
        "type": "readonly FunnelStep[]",
        "required": true,
        "origin": "own",
        "description": "Ordered steps. Without groups each is a subset of the one before (a warning says when one is larger).",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "group": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ]
          }
        }
      },
      {
        "name": "scale",
        "type": "\"first\" | \"max\"",
        "required": false,
        "origin": "own",
        "default": "\"first\"",
        "description": "What the bar widths are measured against: `first` (default) the first step, as in a strict funnel; `max` the\nlargest step, for steps that are not subsets (a later count from another source can be larger).",
        "schema": {
          "type": "string",
          "enum": [
            "first",
            "max"
          ]
        }
      },
      {
        "name": "valueFormatter",
        "type": "ChartValueFormatter",
        "required": false,
        "origin": "own",
        "default": "plain"
      },
      {
        "name": "showStepConversion",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "default": "true",
        "description": "The conversion from the previous step beside each count. On by default.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "showTotalConversion",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "default": "true",
        "description": "The first-to-last conversion in the subtitle. On by default.",
        "schema": {
          "type": "boolean"
        }
      }
    ]
  },
  "tokens": [
    "ds-background-brand-subtle",
    "ds-background-neutral",
    "ds-background-neutral-pressed",
    "ds-background-neutral-subtle-hovered",
    "ds-background-selected",
    "ds-background-selected-hovered",
    "ds-background-selected-pressed",
    "ds-border",
    "ds-border-bold",
    "ds-border-focused",
    "ds-border-selected",
    "ds-chart-1",
    "ds-chart-2",
    "ds-chart-3",
    "ds-chart-4",
    "ds-chart-5",
    "ds-chart-heat",
    "ds-chart-neutral",
    "ds-icon",
    "ds-icon-brand",
    "ds-icon-danger",
    "ds-icon-subtle",
    "ds-icon-success",
    "ds-icon-warning",
    "ds-link",
    "ds-radius-control-small",
    "ds-radius-medium",
    "ds-radius-small",
    "ds-radius-xsmall",
    "ds-shadow-overlay",
    "ds-space-050",
    "ds-space-075",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-space-300",
    "ds-space-400",
    "ds-surface-overlay",
    "ds-surface-raised",
    "ds-text",
    "ds-text-danger",
    "ds-text-subtle",
    "ds-text-subtlest",
    "ds-text-success"
  ],
  "strings": [
    "chartBand",
    "chartCategory",
    "chartConversion",
    "chartNoData",
    "chartOther",
    "chartPeriod",
    "chartShare",
    "chartStatus",
    "chartTrend",
    "chartValue",
    "gaugeTarget",
    "heatmapLess",
    "heatmapMore",
    "hideDataTable",
    "selection",
    "showAll",
    "showDataTable",
    "showFewer",
    "sparklineSummary"
  ],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
