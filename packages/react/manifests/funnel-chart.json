{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "charts",
  "status": "alpha",
  "import": "@senvenli/react/charts",
  "name": "funnel-chart",
  "title": "Funnel chart",
  "exports": [
    "FunnelChart"
  ],
  "description": "Steps of a process with how many reach each one and the conversion between them.",
  "keywords": [
    "funnel-chart",
    "conversion",
    "steps"
  ],
  "usage": {
    "when": [
      "Where people drop out of a flow."
    ]
  },
  "a11y": {
    "builtIn": [
      "A \"Show as table\" button shows the same data as a table, which screen readers get by default."
    ],
    "youProvide": [
      "A title that says what the figure is."
    ]
  },
  "related": [
    "bar-chart"
  ],
  "genui": {
    "expose": false
  },
  "source": [
    "src/charts/list-charts.tsx"
  ],
  "props": {
    "FunnelChart": [
      {
        "name": "title",
        "type": "string",
        "required": true,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "period",
        "type": "string",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "isLoading",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "emptyMessage",
        "type": "{ title: string; description?: string | undefined; }",
        "required": false,
        "origin": "own"
      },
      {
        "name": "steps",
        "type": "readonly FunnelStep[]",
        "required": true,
        "origin": "own",
        "description": "Truly ordered steps, each a subset of the one before.",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "value"
            ]
          }
        }
      },
      {
        "name": "valueFormatter",
        "type": "ChartValueFormatter",
        "required": false,
        "origin": "own",
        "default": "plain"
      },
      {
        "name": "showStepConversion",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "default": "true",
        "description": "The conversion from the previous step beside each count. On by default.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "showTotalConversion",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "default": "true",
        "description": "The first-to-last conversion in the subtitle. On by default.",
        "schema": {
          "type": "boolean"
        }
      }
    ]
  },
  "tokens": [
    "ds-background-brand-subtle",
    "ds-background-neutral",
    "ds-background-neutral-pressed",
    "ds-background-selected-hovered",
    "ds-background-selected-pressed",
    "ds-border",
    "ds-border-bold",
    "ds-border-focused",
    "ds-chart-1",
    "ds-chart-2",
    "ds-chart-3",
    "ds-chart-4",
    "ds-chart-5",
    "ds-chart-neutral",
    "ds-icon-danger",
    "ds-icon-success",
    "ds-icon-warning",
    "ds-link",
    "ds-radius-medium",
    "ds-radius-small",
    "ds-radius-xsmall",
    "ds-shadow-overlay",
    "ds-space-050",
    "ds-space-075",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-space-300",
    "ds-space-400",
    "ds-surface-overlay",
    "ds-surface-raised",
    "ds-text",
    "ds-text-danger",
    "ds-text-subtle",
    "ds-text-subtlest",
    "ds-text-success"
  ],
  "strings": [
    "chartBand",
    "chartCategory",
    "chartConversion",
    "chartNoData",
    "chartOther",
    "chartPeriod",
    "chartShare",
    "chartStatus",
    "chartTrend",
    "chartValue",
    "gaugeTarget",
    "heatmapLess",
    "heatmapMore",
    "hideDataTable",
    "showAll",
    "showDataTable",
    "showFewer",
    "sparklineSummary"
  ],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
