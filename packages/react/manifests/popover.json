{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "overlay",
  "status": "alpha",
  "import": "@senvenli/react/overlay",
  "genui": {
    "expose": false
  },
  "name": "popover",
  "title": "Popover",
  "exports": [
    "Popover"
  ],
  "description": "Non-modal content anchored to a trigger: extra detail, a small form, a picker.",
  "keywords": [
    "popover",
    "popup",
    "flyout",
    "dropdown"
  ],
  "usage": {
    "when": [
      "Showing a little interactive content next to what opened it."
    ],
    "instead": [
      {
        "use": "tooltip",
        "when": "It is only a short hint."
      },
      {
        "use": "hover-card",
        "when": "A preview of a link or person that opens on hover, with no click."
      }
    ]
  },
  "a11y": {
    "keyboard": [
      {
        "keys": "Esc",
        "does": "Closes and returns focus to the trigger."
      }
    ],
    "builtIn": [
      "Positioned to stay on screen, also in RTL."
    ],
    "youProvide": [
      "A trigger with a clear name."
    ]
  },
  "related": [
    "tooltip",
    "menu"
  ],
  "source": [
    "src/overlay/floating.tsx"
  ],
  "props": {
    "Popover": [
      {
        "name": "trigger",
        "type": "ReactElement<unknown, string | JSXElementConstructor<any>>",
        "required": true,
        "origin": "own",
        "description": "The pressable that opens it (a DS Button: \"Filtre\")."
      },
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": true,
        "origin": "own"
      },
      {
        "name": "placement",
        "type": "Placement",
        "required": false,
        "origin": "own",
        "description": "\"bottom start\" by default; React Aria flips it when there is no room.",
        "schema": {
          "type": "string",
          "enum": [
            "top",
            "bottom",
            "left",
            "right",
            "start",
            "end",
            "bottom left",
            "bottom right",
            "bottom start",
            "bottom end",
            "top left",
            "top right",
            "top start",
            "top end",
            "left top",
            "left bottom",
            "start top",
            "start bottom",
            "right top",
            "right bottom",
            "end top",
            "end bottom"
          ]
        }
      },
      {
        "name": "isOpen",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "defaultOpen",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "onOpenChange",
        "type": "(isOpen: boolean) => void",
        "required": false,
        "origin": "own"
      },
      {
        "name": "title",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own",
        "description": "A heading that also names the panel (\"Filters\"); without it, give `aria-label`."
      },
      {
        "name": "aria-label",
        "type": "string",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "motion",
        "type": "ComponentMotion",
        "required": false,
        "origin": "own",
        "description": "`auto` (follow the device), `reduce` or `none`, for this component; the provider's setting otherwise.",
        "schema": {
          "type": "string",
          "enum": [
            "none",
            "auto",
            "reduce"
          ]
        }
      }
    ]
  },
  "tokens": [
    "ds-background-neutral-bold",
    "ds-background-neutral-pressed",
    "ds-background-neutral-subtle-hovered",
    "ds-blanket",
    "ds-border",
    "ds-border-focused",
    "ds-easing-enter",
    "ds-easing-exit",
    "ds-icon-danger",
    "ds-icon-subtle",
    "ds-radius-small",
    "ds-radius-xlarge",
    "ds-shadow-overlay",
    "ds-space-050",
    "ds-space-075",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-space-300",
    "ds-surface-overlay",
    "ds-text",
    "ds-text-danger",
    "ds-text-disabled",
    "ds-text-inverse",
    "ds-text-subtle",
    "ds-text-subtlest",
    "font-ds-mono"
  ],
  "strings": [],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
