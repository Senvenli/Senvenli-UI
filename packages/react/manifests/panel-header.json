{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "navigation",
  "status": "alpha",
  "import": "@senvenli/react/navigation",
  "name": "panel-header",
  "title": "Panel header",
  "exports": [
    "PanelHeader",
    "PanelHeaderBar",
    "PanelHeaderProvider"
  ],
  "description": "An app page's header bar: menu button on small screens, the page title and its actions.",
  "keywords": [
    "page header",
    "title bar",
    "app shell",
    "header"
  ],
  "usage": {
    "when": [
      "Titling a page inside an app shell with a sidebar."
    ]
  },
  "a11y": {
    "builtIn": [
      "The menu button is named \"Open menu\" and opens the sidebar panel."
    ],
    "youProvide": [
      "A page title."
    ]
  },
  "related": [
    "sidebar"
  ],
  "genui": {
    "expose": false
  },
  "source": [
    "src/navigation/panel-header.tsx"
  ],
  "props": {
    "PanelHeader": [
      {
        "name": "title",
        "type": "React.ReactNode",
        "required": true,
        "description": "The page's name; the page's one h1."
      },
      {
        "name": "description",
        "type": "React.ReactNode",
        "required": false,
        "description": "One line under the title."
      },
      {
        "name": "breadcrumbs",
        "type": "readonly BreadcrumbItem[]",
        "required": false,
        "description": "Where the page sits, above the title (a detail page under its list).",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string"
              }
            },
            "required": [
              "label"
            ]
          }
        }
      },
      {
        "name": "actions",
        "type": "React.ReactNode",
        "required": false,
        "description": "The page's actions: filters, a search field, one primary button."
      }
    ],
    "PanelHeaderBar": [
      {
        "name": "menuLabel",
        "type": "string",
        "required": true,
        "description": "The menu button's name (\"Open menu\"); it opens the Sidebar, which is a panel under 1024px.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "onMenuPress",
        "type": "() => void",
        "required": true
      }
    ],
    "PanelHeaderProvider": [
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": true
      }
    ]
  },
  "tokens": [
    "ds-border",
    "ds-border-focused",
    "ds-icon-subtle",
    "ds-radius-small",
    "ds-space-025",
    "ds-space-050",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-space-300",
    "ds-space-400",
    "ds-surface",
    "ds-text",
    "ds-text-subtle"
  ],
  "strings": [
    "location",
    "showHiddenLevels"
  ],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
