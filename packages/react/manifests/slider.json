    "slider",
    "range",
    "volume",
    "value"
  ],
  "usage": {
    "when": [
      "An approximate value or range matters more than an exact number."
    ],
    "instead": [
      {
        "use": "number-field",
        "when": "The exact number matters."
      }
    ]
  },
