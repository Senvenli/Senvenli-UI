    "keyboard": [
      {
        "keys": "Arrow keys",
        "does": "Moves the thumb by a step."
      },
      {
        "keys": "Home, End",
        "does": "Moves to the minimum or maximum."
      }
    ],
    "builtIn": [
      "Each thumb is a slider with its value text."
    ],
    "youProvide": [
      "A label."
    ]
  },
  "related": [
    "number-field"
  ],
