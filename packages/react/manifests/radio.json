{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "selection",
  "status": "alpha",
  "import": "@senvenli/react/selection",
  "name": "radio",
  "title": "Radio group",
  "exports": [
    "RadioGroup",
    "Radio"
  ],
  "description": "One choice from a few options that all stay visible.",
  "keywords": [
    "radio",
    "options",
    "choice",
    "single"
  ],
  "usage": {
    "when": [
      "One choice from 2 to 5 options people should compare."
    ],
    "instead": [
      {
        "use": "select",
        "when": "There are many options."
      },
      {
        "use": "list-box",
        "when": "Options need icons or descriptions, or several may be picked, in a visible list."
      }
    ]
  },
  "a11y": {
    "keyboard": [
      {
        "keys": "Arrow keys",
        "does": "Moves and selects within the group."
      }
    ],
    "builtIn": [
      "One tab stop for the group.",
      "Required fields show \"Fill in this field.\" after a blur or a submit; your own `errorMessage` replaces it."
    ],
    "youProvide": [
      "A label for the group."
    ]
  },
  "related": [
    "select",
    "checkbox"
  ],
  "genui": {
    "expose": true,
    "description": "One choice from a few visible options. items are {value, label, description?}. Emits change.",
    "props": [
      "label",
      "items",
      "description"
    ],
    "children": "none",
    "events": [
      "change"
    ],
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "The group legend, required."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "isDisabled": {
                "type": "boolean"
              }
            },
            "required": [
              "value",
              "label"
            ]
          },
          "description": "The options as data, or `Radio` children."
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "label"
      ]
    }
  },
  "guidance": [
    {
      "rule": "Use variant=\"card\" when each option needs a line of detail (a plan, a delivery option, a time slot); its content is yours."
    }
  ],
  "source": [
    "src/selection/radio.tsx"
  ],
