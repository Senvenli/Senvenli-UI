{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "action",
  "status": "alpha",
  "import": "@senvenli/react/action",
  "name": "link",
  "title": "Link",
  "exports": [
    "Link"
  ],
  "description": "Text that goes to another page, inline in running text or as a standalone subtle link.",
  "keywords": [
    "link",
    "anchor",
    "href",
    "navigation"
  ],
  "usage": {
    "when": [
      "Going to another page from within text or a footer."
    ],
    "instead": [
      {
        "use": "link-button",
        "when": "The link is a call to action that should look like a button."
      }
    ]
  },
  "guidance": [
    {
      "rule": "Name the destination; never \"click here\"."
    }
  ],
  "a11y": {
    "keyboard": [
      {
        "keys": "Enter",
        "does": "Follows the link."
      }
    ],
    "builtIn": [
      "External links open in a new tab safely and say so to screen readers."
    ],
    "youProvide": [
      "Link text that makes sense on its own."
    ]
  },
  "related": [
    "link-button"
  ],
  "genui": {
    "expose": true,
    "description": "A text link to another page. Children name the destination; set isExternal for other sites.",
    "props": [
      "href",
      "variant",
      "isExternal"
    ],
    "children": "text",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "href": {
          "type": "string",
          "description": "A URL to link to. See [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a#href)."
        },
        "variant": {
          "type": "string",
          "enum": [
            "default",
            "inline",
            "subtle"
          ],
          "description": "`inline` in running text (always underlined), `subtle` in footers and legal rows."
        },
        "isExternal": {
          "type": "boolean",
          "description": "Opens in a new tab with `noopener noreferrer` and shows the 12px `arrow-up-right`."
        }
      }
    }
  },
  "source": [
    "src/action/link.tsx"
