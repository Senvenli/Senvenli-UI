        "schema": {
          "type": "string"
        }
      },
      {
        "name": "ping",
        "type": "string",
        "required": false,
        "description": "A space-separated list of URLs to ping when the link is followed. See\n[MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a#ping).",
