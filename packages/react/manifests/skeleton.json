{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "feedback",
  "status": "alpha",
  "import": "@senvenli/react/feedback",
  "name": "skeleton",
  "title": "Skeleton",
  "exports": [
    "Skeleton",
    "SkeletonText",
    "SkeletonCircle",
    "SkeletonGroup"
  ],
  "description": "Placeholder shapes in the layout of content that is still loading.",
  "keywords": [
    "skeleton",
    "placeholder",
    "loading",
    "shimmer"
  ],
  "usage": {
    "when": [
      "A layout is loading and its shape is known."
    ]
  },
  "a11y": {
    "builtIn": [
      "SkeletonGroup marks the region busy and announces when it has loaded."
    ],
    "youProvide": [
      "A `label` on SkeletonGroup that says what is loading."
    ]
  },
  "related": [
    "spinner"
  ],
  "genui": {
    "expose": false
  },
  "source": [
    "src/feedback/skeleton.tsx"
  ],
  "props": {
    "Skeleton": [
      {
        "name": "isLoaded",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "description": "Shows the children instead of the shape once the data is there.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own"
      },
      {
        "name": "delay",
        "type": "number",
        "required": false,
        "origin": "own",
        "description": "Milliseconds before the shape appears (default 300); the space is held meanwhile.",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "width",
        "type": "string | number",
        "required": false,
        "origin": "own",
        "description": "CSS width (\"60%\", 240); default full width.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "height",
        "type": "string | number",
        "required": false,
        "origin": "own",
        "default": "12",
        "description": "CSS height; default 12px (a text line).",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "radius",
        "type": "\"none\" | \"small\" | \"medium\" | \"large\" | \"full\"",
        "required": false,
        "origin": "own",
        "default": "\"small\"",
        "description": "The radius of what it replaces: `medium` for a button, `large` for a card photo.",
        "schema": {
          "type": "string",
          "enum": [
            "none",
            "small",
            "medium",
            "large",
            "full"
          ]
        }
      },
      {
        "name": "aspectRatio",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "Aspect ratio for photos (\"16/9\").",
        "schema": {
          "type": "string"
        }
      }
    ],
    "SkeletonText": [
      {
        "name": "isLoaded",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "description": "Shows the children instead of the shape once the data is there.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own"
      },
      {
        "name": "delay",
        "type": "number",
        "required": false,
        "origin": "own",
        "description": "Milliseconds before the shape appears (default 300); the space is held meanwhile.",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "lines",
        "type": "number",
        "required": false,
        "origin": "own",
        "default": "2",
        "description": "Number of 12px lines; the last one is shorter, as text is.",
        "schema": {
          "type": "number"
        }
      }
    ],
    "SkeletonCircle": [
      {
        "name": "isLoaded",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "description": "Shows the children instead of the shape once the data is there.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own"
      },
      {
        "name": "delay",
        "type": "number",
        "required": false,
        "origin": "own",
        "description": "Milliseconds before the shape appears (default 300); the space is held meanwhile.",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "size",
        "type": "number",
        "required": false,
        "origin": "own",
        "default": "32",
        "description": "Diameter in px (32 for a list avatar).",
        "schema": {
          "type": "number"
        }
      }
    ],
    "SkeletonGroup": [
      {
        "name": "label",
        "type": "string",
        "required": true,
        "origin": "own",
        "description": "What is loading (\"Loading orders\"); the region's name while busy.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "loadedLabel",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "The region's name once loaded (\"Orders\"); none by default.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "isLoading",
        "type": "boolean",
        "required": true,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": true,
        "origin": "own"
      }
    ]
  },
  "tokens": [
    "ds-background-neutral",
    "ds-radius-full",
    "ds-radius-large",
    "ds-radius-medium",
    "ds-radius-small",
    "ds-space-075"
  ],
  "strings": [],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
