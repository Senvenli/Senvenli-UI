{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "feedback",
  "status": "alpha",
  "import": "@senvenli/react/feedback",
  "name": "skeleton",
  "title": "Skeleton",
  "exports": [
    "Skeleton",
    "SkeletonGroup"
  ],
  "description": "Placeholder shapes in the layout of content that is still loading.",
  "keywords": [
    "skeleton",
    "placeholder",
    "loading",
    "shimmer"
  ],
  "usage": {
    "when": [
      "A layout is loading and its shape is known."
    ],
    "instead": [
      {
        "use": "spinner",
        "when": "The layout of what loads is unknown or very small."
      },
      {
        "use": "progress",
        "when": "The task's progress can be measured."
      }
    ]
  },
  "a11y": {
    "builtIn": [
      "SkeletonGroup marks the region busy and announces when it has loaded."
    ],
    "youProvide": [
      "A `label` on SkeletonGroup that says what is loading."
    ]
  },
  "related": [
    "spinner"
  ],
  "genui": {
    "expose": false
  },
  "source": [
    "src/feedback/skeleton.tsx"
  ],
  "props": {
    "Skeleton": [
      {
        "name": "isLoaded",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "description": "Shows the children instead of the shape once the data is there.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own"
      },
      {
        "name": "delay",
        "type": "number",
        "required": false,
        "origin": "own",
        "description": "Milliseconds before the shape appears (default 300); the space is held meanwhile.",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "variant",
        "type": "\"text\" | \"circle\" | \"rectangle\"",
        "required": false,
        "origin": "own",
        "description": "`rectangle` (default): a block of `width` × `height`; `text`: `lines` of text, the last one shorter;\n`circle`: an avatar of `size` px.",
        "schema": {
          "type": "string",
          "enum": [
            "text",
            "circle",
            "rectangle"
          ]
        }
      },
      {
        "name": "lines",
        "type": "number",
        "required": false,
        "origin": "own",
        "description": "`text`: the number of 12px lines (default 2).",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "size",
        "type": "number",
        "required": false,
        "origin": "own",
        "description": "`circle`: the diameter in px (default 32, a list avatar).",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "width",
        "type": "string | number",
        "required": false,
        "origin": "own",
        "description": "CSS width (\"60%\", 240); default full width.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "height",
        "type": "string | number",
        "required": false,
        "origin": "own",
        "description": "CSS height; default 12px (a text line).",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "radius",
        "type": "\"none\" | \"small\" | \"medium\" | \"large\" | \"full\"",
        "required": false,
        "origin": "own",
        "description": "The radius of what it replaces: `medium` for a button, `large` for a card photo.",
        "schema": {
          "type": "string",
          "enum": [
            "none",
            "small",
            "medium",
            "large",
            "full"
          ]
        }
      },
      {
        "name": "aspectRatio",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "Aspect ratio for photos (\"16/9\").",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "motion",
        "type": "ComponentMotion",
        "required": false,
        "origin": "own",
        "description": "`auto` (follow the device), `reduce` or `none`, for this component; the provider's setting otherwise.",
        "schema": {
          "type": "string",
          "enum": [
            "none",
            "auto",
            "reduce"
          ]
        }
      }
    ],
    "SkeletonGroup": [
      {
        "name": "label",
        "type": "string",
        "required": true,
        "origin": "own",
        "description": "What is loading (\"Loading orders\"); the region's name while busy.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "loadedLabel",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "The region's name once loaded (\"Orders\"); none by default.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "isLoading",
        "type": "boolean",
        "required": true,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": true,
        "origin": "own"
      }
    ]
  },
  "tokens": [
    "ds-background-neutral",
    "ds-radius-full",
    "ds-radius-large",
    "ds-radius-medium",
    "ds-radius-small",
    "ds-space-075"
  ],
  "strings": [],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
