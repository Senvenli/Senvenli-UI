{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "action",
  "status": "alpha",
  "import": "@senvenli/react/action",
  "name": "theme-toggle",
  "title": "Theme toggle",
  "exports": [
    "ThemeToggle"
  ],
  "description": "Lets people choose system, light or dark theme, stored per device and applied before first paint.",
  "keywords": [
    "theme",
    "dark mode",
    "light mode",
    "appearance"
  ],
  "usage": {
    "when": [
      "An app or site offers light and dark themes."
    ]
  },
  "a11y": {
    "keyboard": [
      {
        "keys": "Arrow keys",
        "does": "Moves between and selects the options."
      }
    ],
    "builtIn": [
      "One tab stop; a radio group named \"Theme\".",
      "System says which theme is in effect now."
    ],
    "youProvide": []
  },
  "genui": {
    "expose": false
  },
  "source": [
    "src/action/theme-toggle.tsx"
  ],
  "props": {
    "ThemeToggle": [
      {
        "name": "value",
        "type": "ThemeChoice",
        "required": false,
        "origin": "own",
        "description": "Controlled choice; leave out to let the toggle manage, store and apply it.",
        "schema": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ]
        }
      },
      {
        "name": "onChange",
        "type": "(choice: ThemeChoice) => void",
        "required": false,
        "origin": "own"
      },
      {
        "name": "labels",
        "type": "Partial<ThemeLabels>",
        "required": false,
        "origin": "own",
        "description": "Localized names; the locale's built-in strings by default."
      },
      {
        "name": "storageKey",
        "type": "string",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "appearance",
        "type": "\"list\" | \"segmented\"",
        "required": false,
        "origin": "own",
        "default": "\"segmented\"",
        "description": "`segmented` for the Navbar; `list` (a three-option list with a check) for the phone menu.",
        "schema": {
          "type": "string",
          "enum": [
            "list",
            "segmented"
          ]
        }
      }
    ]
  },
  "tokens": [
    "ds-background-neutral",
    "ds-background-neutral-bold",
    "ds-background-neutral-subtle-hovered",
    "ds-background-segment-selected",
    "ds-border-focused",
    "ds-icon",
    "ds-icon-subtle",
    "ds-radius-medium",
    "ds-radius-small",
    "ds-shadow-raised",
    "ds-size-control",
    "ds-space-050",
    "ds-space-100",
    "ds-space-150",
    "ds-text",
    "ds-text-inverse",
    "ds-text-subtle"
  ],
  "strings": [
    "theme",
    "themeDark",
    "themeLight",
    "themeNowDark",
    "themeNowLight",
    "themeSystem"
  ],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
