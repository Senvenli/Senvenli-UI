{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "collection",
  "status": "alpha",
  "import": "@senvenli/react/collection",
  "name": "grid-list",
  "title": "Grid list",
  "exports": [
    "GridList"
  ],
  "description": "Selectable tiles in a responsive grid with arrow-key navigation, tile actions and optional drag to reorder.",
  "keywords": [
    "grid",
    "tiles",
    "gallery",
    "photos",
    "reorder"
  ],
  "usage": {
    "when": [
      "Items people recognize by an image: photos, documents, cards."
    ],
    "instead": [
      {
        "use": "list",
        "when": "Items are recognized by text."
      }
    ]
  },
  "a11y": {
    "keyboard": [
      {
        "keys": "Arrow keys",
        "does": "Move between tiles in two dimensions."
      },
      {
        "keys": "Space",
        "does": "Selects the focused tile."
      }
    ],
    "builtIn": [
      "Tile actions are always visible, so they need no hover and work on touch.",
      "A drag handle gives the keyboard a way to reorder."
    ],
    "youProvide": [
      "An aria-label, and a name for each tile action that names the tile."
    ]
  },
  "related": [
    "list",
    "table"
  ],
  "genui": {
    "expose": false
  },
  "source": [
    "src/collection/grid-list.tsx"
  ],
  "props": {
    "GridList": [
      {
        "name": "aria-label",
        "type": "string",
        "required": true,
        "origin": "own",
        "description": "Names the grid (\"Product photos\").",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "items",
        "type": "readonly T[]",
        "required": true,
        "origin": "own",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      {
        "name": "itemKey",
        "type": "(item: T) => Key",
        "required": false,
        "origin": "own",
        "default": "(item) => (item as { id: Key }).id",
        "description": "The item's stable id; `item.id` by default."
      },
      {
        "name": "renderItem",
        "type": "(item: T) => GridTileContent",
        "required": true,
        "origin": "own"
      },
      {
        "name": "selectionMode",
        "type": "\"none\" | \"single\" | \"multiple\"",
        "required": false,
        "origin": "own",
        "default": "\"none\"",
        "schema": {
          "type": "string",
          "enum": [
            "none",
            "single",
            "multiple"
          ]
        }
      },
      {
        "name": "selectedKeys",
        "type": "\"all\" | Iterable<Key>",
        "required": false,
        "origin": "own"
      },
      {
        "name": "defaultSelectedKeys",
        "type": "\"all\" | Iterable<Key>",
        "required": false,
        "origin": "own"
      },
      {
        "name": "onSelectionChange",
        "type": "(keys: Selection) => void",
        "required": false,
        "origin": "own"
      },
      {
        "name": "onAction",
        "type": "(key: Key) => void",
        "required": false,
        "origin": "own",
        "description": "Enter, or a press, opens the tile."
      },
      {
        "name": "dragAndDrop",
        "type": "{ onReorder: (keys: Set<Key>, target: { key: Key; position: \"before\" | \"after\" }) => void }",
        "required": false,
        "origin": "own",
        "description": "Reordering (photos): drag a tile, or focus its handle and use the keyboard. `onReorder` gets the moved\nkeys and the tile they go before or after."
      },
      {
        "name": "renderEmptyState",
        "type": "() => ReactNode",
        "required": false,
        "origin": "own",
        "description": "Shown when there are no items."
      },
      {
        "name": "ref",
        "type": "React.Ref<HTMLDivElement>",
        "required": false,
        "origin": "own",
        "description": "The grid element. Focusing it focuses the tile React Aria keeps as focused (the next one after a removed tile),\nso it is the `returnFocusRef` for a confirm whose action removes the tile it was opened from."
      }
    ]
  },
  "tokens": [
    "ds-background-danger",
    "ds-border-focused",
    "ds-border-selected",
    "ds-icon-danger",
    "ds-radius-large",
    "ds-radius-small",
    "ds-shadow-raised",
    "ds-space-025",
    "ds-space-050",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-space-500",
    "ds-surface-hovered",
    "ds-surface-raised",
    "ds-surface-sunken",
    "ds-text",
    "ds-text-disabled",
    "ds-text-subtle"
  ],
  "strings": [],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
