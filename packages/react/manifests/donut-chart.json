{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "charts",
  "status": "alpha",
  "import": "@senvenli/react/charts",
  "name": "donut-chart",
  "title": "Donut chart",
  "exports": [
    "DonutChart"
  ],
  "description": "Parts of a whole, two to five, with the total in the center and exact shares; more parts fold into \"Other\".",
  "keywords": [
    "chart",
    "donut",
    "pie",
    "share"
  ],
  "usage": {
    "when": [
      "Shares of one total, at most five parts."
    ],
    "instead": [
      {
        "use": "bar-list",
        "when": "There are many parts or they are compared, not summed."
      }
    ]
  },
  "a11y": {
    "builtIn": [
      "A \"Show as table\" button shows the same data as a table, which screen readers get by default."
    ],
    "youProvide": [
      "A title that says what the figure is."
    ]
  },
  "related": [
    "bar-list"
  ],
  "genui": {
    "expose": true,
    "description": "Shares of one total, two to five parts. More fold into Other.",
    "props": [
      "title",
      "period",
      "data",
      "centerLabel"
    ],
    "children": "none",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "What the chart shows, over it; leave it out when a card or a heading already says so."
        },
        "period": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "description": "Two to five parts; more are folded into \"Other\"."
        },
        "centerLabel": {
          "type": "string",
          "description": "Under the total in the center: its unit (\"orders\")."
        }
      },
      "required": [
        "data"
      ]
    }
  },
  "source": [
    "src/charts/more-charts.tsx"
  ],
  "props": {
    "DonutChart": [
      {
        "name": "tableView",
        "type": "ChartTableView",
        "required": false,
        "origin": "own",
        "description": "How the data is offered as a table. `swap` (default): a toggle at the end of the chart's top row turns the plot\ninto the table at the same height, scrolling inside, so the card never grows. `hidden`: no toggle; the table is\nthere for screen readers only. `none`: no table at all, for a chart that is already text (BarList).",
        "schema": {
          "type": "string",
          "enum": [
            "hidden",
            "none",
            "swap"
          ]
        }
      },
      {
        "name": "isTableOpen",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "description": "The table is showing (`swap`), controlled; or `defaultTableOpen` + `onTableOpenChange`.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "defaultTableOpen",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "onTableOpenChange",
        "type": "(isOpen: boolean) => void",
        "required": false,
        "origin": "own"
      },
      {
        "name": "title",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "What the chart shows, over it; leave it out when a card or a heading already says so.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "aria-label",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "Names the chart when it has no visible `title` (a card's heading already says what it shows).",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "period",
        "type": "string",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "isLoading",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "emptyState",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own",
        "description": "Shown instead of the plot when there is no data: an `EmptyState size=\"small\"` or text; \"No data\" by default."
      },
      {
        "name": "height",
        "type": "number",
        "required": false,
        "origin": "own",
        "default": "200",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "data",
        "type": "readonly DonutDatum[]",
        "required": true,
        "origin": "own",
        "description": "Two to five parts; more are folded into \"Other\".",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "value"
            ]
          }
        }
      },
      {
        "name": "valueFormatter",
        "type": "ChartValueFormatter",
        "required": false,
        "origin": "own",
        "default": "plain"
      },
      {
        "name": "centerLabel",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "Under the total in the center: its unit (\"orders\").",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "showList",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "default": "true",
        "description": "The value list beside the ring with exact percentages; on by default.",
        "schema": {
          "type": "boolean"
        }
      }
    ]
  },
  "tokens": [
    "ds-background-neutral",
    "ds-background-neutral-pressed",
    "ds-background-neutral-subtle-hovered",
    "ds-background-selected",
    "ds-border",
    "ds-border-bold",
    "ds-border-focused",
    "ds-chart-1",
    "ds-chart-2",
    "ds-chart-3",
    "ds-chart-4",
    "ds-chart-5",
    "ds-chart-neutral",
    "ds-icon",
    "ds-icon-brand",
    "ds-icon-subtle",
    "ds-radius-control-small",
    "ds-radius-full",
    "ds-radius-medium",
    "ds-radius-small",
    "ds-radius-xsmall",
    "ds-shadow-overlay",
    "ds-space-050",
    "ds-space-075",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-space-300",
    "ds-space-400",
    "ds-surface-overlay",
    "ds-surface-raised",
    "ds-text",
    "ds-text-danger",
    "ds-text-subtle",
    "ds-text-subtlest",
    "ds-text-success"
  ],
  "strings": [
    "chartCategory",
    "chartNoData",
    "chartNotes",
    "chartOther",
    "chartPeriod",
    "chartShare",
    "chartTrend",
    "chartValue",
    "gaugeTarget",
    "hideDataTable",
    "selection",
    "showDataTable",
    "sparklineSummary"
  ],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
