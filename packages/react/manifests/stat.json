{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "display",
  "status": "alpha",
  "import": "@senvenli/react/display",
  "name": "stat",
  "title": "Stat",
  "exports": [
    "Stat",
    "StatGroup"
  ],
  "description": "A key figure with its label, an optional change against a named period and a sparkline.",
  "keywords": [
    "kpi",
    "metric",
    "figure",
    "dashboard",
    "delta"
  ],
  "usage": {
    "when": [
      "A dashboard's headline numbers."
    ],
    "instead": [
      {
        "use": "description-list",
        "when": "Several labeled facts about one record."
      }
    ]
  },
  "a11y": {
    "builtIn": [
      "The change is announced in words, not only by its arrow and color.",
      "Figures keep their formatted order in right-to-left pages."
    ],
    "youProvide": [
      "A formatted value and, next to a change, the period it compares against."
    ]
  },
  "related": [
    "description-list"
  ],
  "genui": {
    "expose": true,
    "description": "One headline figure. Format the value first; name the period next to a change.",
    "props": [
      "label",
      "value",
      "comparison"
    ],
    "children": "none",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "description": "The figure, already formatted with Intl (\"$48,920\")."
        },
        "comparison": {
          "type": "string",
          "description": "The period the delta compares against (\"vs. September\"); required next to a delta."
        }
      },
      "required": [
        "label",
        "value"
      ]
    }
  },
  "source": [
    "src/display/stat.tsx"
  ],
  "props": {
    "Stat": [
      {
        "name": "label",
        "type": "React.ReactNode",
        "required": true,
        "origin": "own"
      },
      {
        "name": "value",
        "type": "React.ReactNode",
        "required": true,
        "origin": "own",
        "description": "The figure, already formatted with Intl (\"$48,920\")."
      },
      {
        "name": "delta",
        "type": "StatDelta",
        "required": false,
        "origin": "own"
      },
      {
        "name": "comparison",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own",
        "description": "The period the delta compares against (\"vs. September\"); required next to a delta."
      },
      {
        "name": "trend",
        "type": "number[]",
        "required": false,
        "origin": "own",
        "description": "A short series for the sparkline.",
        "schema": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      {
        "name": "href",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "Makes the whole tile a link to the report behind it. Ignored inside a selectable StatGroup.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "id",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "Stable key for selection in a StatGroup with `selectionMode` (\"revenue\", not the label).",
        "schema": {
          "type": "string"
        }
      }
    ],
    "StatGroup": [
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": true,
        "origin": "own"
      },
      {
        "name": "aria-label",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "Names the group; required with `selectionMode` so the choice has a visible or spoken name.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "aria-labelledby",
        "type": "string",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "selectionMode",
        "type": "\"single\" | \"multiple\"",
        "required": false,
        "origin": "own",
        "description": "Makes the tiles selectable, e.g. the metric a chart below shows. \"single\" is a radio\ngroup (arrow keys move, one is chosen); \"multiple\" makes each tile a pressed/not\npressed toggle. Each Stat needs an `id`.",
        "schema": {
          "type": "string",
          "enum": [
            "single",
            "multiple"
          ]
        }
      },
      {
        "name": "selectedKeys",
        "type": "Iterable<Key>",
        "required": false,
        "origin": "own"
      },
      {
        "name": "defaultSelectedKeys",
        "type": "Iterable<Key>",
        "required": false,
        "origin": "own"
      },
      {
        "name": "onSelectionChange",
        "type": "(keys: Set<Key>) => void",
        "required": false,
        "origin": "own"
      },
      {
        "name": "disallowEmptySelection",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "description": "Keeps at least one tile selected (a chart always shows a metric).",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "label",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own",
        "description": "A visible name over the group (\"Business\", \"Website\"); it also names the group for assistive tech."
      },
      {
        "name": "density",
        "type": "\"default\" | \"compact\"",
        "required": false,
        "origin": "own",
        "default": "\"default\"",
        "description": "`default`: separate tiles, at most four in a row. `compact`: up to six in a row on one shared surface divided by\nlines, with a smaller figure, for a row of secondary figures.",
        "schema": {
          "type": "string",
          "enum": [
            "default",
            "compact"
          ]
        }
      }
    ]
  },
  "tokens": [
    "ds-background-brand-subtle",
    "ds-background-selected",
    "ds-border",
    "ds-border-focused",
    "ds-border-selected",
    "ds-chart-1",
    "ds-easing-standard",
    "ds-icon",
    "ds-icon-brand",
    "ds-icon-danger",
    "ds-icon-information",
    "ds-icon-subtle",
    "ds-icon-success",
    "ds-icon-warning",
    "ds-radius-large",
    "ds-shadow-overlay",
    "ds-shadow-raised",
    "ds-size-icon",
    "ds-size-icon-large",
    "ds-size-icon-small",
    "ds-space-025",
    "ds-space-050",
    "ds-space-075",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-surface-hovered",
    "ds-surface-raised",
    "ds-text",
    "ds-text-danger",
    "ds-text-subtle",
    "ds-text-subtlest",
    "ds-text-success"
  ],
  "strings": [
    "deltaDown",
    "deltaUp",
    "noChange"
  ],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
