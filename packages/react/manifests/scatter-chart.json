{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "charts",
  "status": "alpha",
  "import": "@senvenli/react/charts",
  "name": "scatter-chart",
  "title": "Scatter chart",
  "exports": [
    "ScatterChart"
  ],
  "description": "Points on two value axes, for seeing a relation and outliers.",
  "keywords": [
    "chart",
    "scatter",
    "correlation"
  ],
  "usage": {
    "when": [
      "How two measures of the same items relate."
    ]
  },
  "a11y": {
    "keyboard": [
      {
        "keys": "Arrow keys",
        "does": "Move between points."
      }
    ],
    "builtIn": [
      "A \"Show as table\" button shows the same data as a table, which screen readers get by default."
    ],
    "youProvide": [
      "A title that says what the figure is."
    ]
  },
  "related": [
    "bar-chart"
  ],
  "genui": {
    "expose": false
  },
  "source": [
    "src/charts/more-charts.tsx"
  ],
  "props": {
    "ScatterChart": [
      {
        "name": "title",
        "type": "string",
        "required": true,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "period",
        "type": "string",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "isLoading",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "emptyMessage",
        "type": "{ title: string; description?: string | undefined; }",
        "required": false,
        "origin": "own"
      },
      {
        "name": "height",
        "type": "number",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "data",
        "type": "readonly T[]",
        "required": true,
        "origin": "own",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      {
        "name": "name",
        "type": "keyof T & string",
        "required": true,
        "origin": "own",
        "description": "The key naming each point (a product's SKU); shown on hover and as the table's row header.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "x",
        "type": "keyof T & string",
        "required": true,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "y",
        "type": "keyof T & string",
        "required": true,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "size",
        "type": "keyof T & string",
        "required": false,
        "origin": "own",
        "description": "A third measure as point size.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "category",
        "type": "{ key: keyof T & string; value: unknown; label: string; otherLabel: string; }",
        "required": false,
        "origin": "own",
        "description": "A second category: `ds-chart-2` and a diamond, so it differs by shape as well as hue."
      },
      {
        "name": "xLabel",
        "type": "string",
        "required": true,
        "origin": "own",
        "description": "Axis names with their units (\"Daily price (€)\").",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "yLabel",
        "type": "string",
        "required": true,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "valueFormatters",
        "type": "{ x?: ChartValueFormatter | undefined; y?: ChartValueFormatter | undefined; }",
        "required": false,
        "origin": "own"
      },
      {
        "name": "trendLine",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "description": "A least-squares trend line, dashed in `ds-chart-neutral`.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "onPointPress",
        "type": "(row: T) => void",
        "required": false,
        "origin": "own",
        "description": "Opens the item: the row under the pointer."
      }
    ]
  },
  "tokens": [
    "ds-background-neutral",
    "ds-background-neutral-pressed",
    "ds-border",
    "ds-border-bold",
    "ds-border-focused",
    "ds-chart-1",
    "ds-chart-2",
    "ds-chart-3",
    "ds-chart-4",
    "ds-chart-5",
    "ds-chart-neutral",
    "ds-link",
    "ds-radius-medium",
    "ds-radius-small",
    "ds-radius-xsmall",
    "ds-shadow-overlay",
    "ds-space-050",
    "ds-space-075",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-space-300",
    "ds-space-400",
    "ds-surface-overlay",
    "ds-surface-raised",
    "ds-text",
    "ds-text-danger",
    "ds-text-subtle",
    "ds-text-subtlest",
    "ds-text-success"
  ],
  "strings": [
    "chartCategory",
    "chartNoData",
    "chartOther",
    "chartPeriod",
    "chartShare",
    "chartTrend",
    "chartValue",
    "gaugeTarget",
    "hideDataTable",
    "showDataTable",
    "sparklineSummary"
  ],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
