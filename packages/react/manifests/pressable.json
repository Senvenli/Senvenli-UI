        "origin": "own",
        "schema": {
          "type": "string",
          "enum": [
            "space-0",
            "space-025",
            "space-050",
            "space-075",
            "space-100",
            "space-150",
            "space-200",
            "space-250",
            "space-300",
            "space-400",
            "space-500",
            "space-600",
            "space-800",
            "space-1000"
          ]
        }
      },
      {
        "name": "paddingBlock",
        "type": "Space",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string",
          "enum": [
            "space-0",
            "space-025",
            "space-050",
            "space-075",
            "space-100",
            "space-150",
            "space-200",
            "space-250",
            "space-300",
            "space-400",
            "space-500",
            "space-600",
            "space-800",
            "space-1000"
          ]
        }
      },
      {
        "name": "background",
        "type": "Background",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string",
          "enum": [
            "neutral",
            "danger",
            "surface",
            "surface-raised",
            "surface-sunken",
            "surface-overlay",
            "selected",
            "brand-subtle",
            "information",
            "success",
            "warning"
          ]
        }
      },
      {
        "name": "radius",
        "type": "Radius",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string",
          "enum": [
            "none",
            "small",
            "medium",
            "large",
            "full"
          ]
        }
      },
      {
        "name": "shadow",
        "type": "Shadow",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string",
          "enum": [
            "raised",
            "overflow",
            "overlay"
          ]
        }
      },
      {
        "name": "border",
        "type": "Border",
        "required": false,
        "origin": "own",
        "schema": {
          "enum": [
            false,
            true,
            "bold"
          ]
        }
      },
      {
        "name": "fullWidth",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "default": "true",
        "description": "As wide as its container (default `true`), as a button or a link; `false` hugs what it holds.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own"
      },
      {
        "name": "isDisabled",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "aria-label",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "Required when the content has no text that names the action.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "id",
        "type": "string",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "onPress",
        "type": "(event: PressEvent) => void",
        "required": false,
        "origin": "own"
      },
      {
        "name": "aria-describedby",
        "type": "string",
        "required": false,
        "origin": "dom",
        "description": "Identifies the element (or elements) that describes the object.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "aria-expanded",
        "type": "boolean | \"true\" | \"false\"",
        "required": false,
        "origin": "dom",
        "description": "Indicates whether the element, or another grouping element it controls, is currently expanded\nor collapsed.",
        "schema": {
          "enum": [
            false,
            true,
            "true",
            "false"
          ]
        }
      },
      {
        "name": "aria-pressed",
        "type": "boolean | \"true\" | \"false\" | \"mixed\"",
        "required": false,
        "origin": "dom",
        "description": "Indicates the current \"pressed\" state of toggle buttons.",
        "schema": {
          "enum": [
            false,
            true,
            "true",
            "false",
            "mixed"
          ]
        }
      },
      {
        "name": "type",
        "type": "\"button\" | \"submit\" | \"reset\"",
        "required": false,
        "origin": "aria",
        "description": "The behavior of the button when used in an HTML form.",
        "schema": {
          "type": "string",
          "enum": [
            "button",
            "submit",
            "reset"
          ]
        }
      },
      {
        "name": "form",
        "type": "string",
        "required": false,
        "origin": "aria",
        "description": "The `<form>` element to associate the button with.\nThe value of this attribute must be the id of a `<form>` in the same document.\nSee [MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/button#form).",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "href",
        "type": "string",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "rel",
        "type": "string",
        "required": false,
        "origin": "aria",
        "description": "The relationship between the linked resource and the current page. See\n[MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Attributes/rel).",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "target",
        "type": "HTMLAttributeAnchorTarget",
        "required": false,
        "origin": "aria",
        "description": "The target window for the link. See\n[MDN](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a#target).",
        "schema": {
          "type": "string"
        }
      }
    ]
  },
  "tokens": [
