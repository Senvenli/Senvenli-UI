{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "action",
  "status": "alpha",
  "import": "@senvenli/react/action",
  "name": "pressable",
  "title": "Pressable",
  "exports": [
    "Pressable"
  ],
  "description": "A Box that is a button or a link as a whole, for custom tiles and rows.",
  "keywords": [
    "clickable",
    "tile",
    "row",
    "button",
    "link"
  ],
  "usage": {
    "when": [
      "A custom-designed tile or row must be pressable."
    ],
    "instead": [
      {
        "use": "card",
        "when": "A standard interactive card fits."
      }
    ]
  },
  "a11y": {
    "keyboard": [
      {
        "keys": "Enter, Space",
        "does": "Presses it (Enter only for links)."
      }
    ],
    "builtIn": [
      "Real button or link semantics with the inner focus border."
    ],
    "youProvide": [
      "An accessible name from its text or `aria-label`."
    ]
  },
  "related": [
    "box",
    "card"
  ],
  "genui": {
    "expose": false
  },
  "source": [
    "src/action/pressable.tsx"
  ],
  "props": {
    "Pressable": [
      {
        "name": "padding",
        "type": "Space",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string",
          "enum": [
            "space-0",
            "space-025",
            "space-050",
            "space-075",
            "space-100",
            "space-150",
            "space-200",
            "space-250",
            "space-300",
            "space-400",
            "space-500",
            "space-600",
            "space-800",
            "space-1000"
          ]
        }
      },
      {
        "name": "paddingInline",
        "type": "Space",
