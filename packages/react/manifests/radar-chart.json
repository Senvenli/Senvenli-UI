{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "charts",
  "status": "alpha",
  "import": "@senvenli/react/charts",
  "name": "radar-chart",
  "title": "Radar chart",
  "exports": [
    "RadarChart"
  ],
  "description": "A few items scored on the same axes, as overlapping polygons.",
  "keywords": [
    "chart",
    "radar",
    "spider",
    "profile"
  ],
  "usage": {
    "when": [
      "Comparing two or three profiles on five to eight measures."
    ],
    "instead": [
      {
        "use": "bar-chart",
        "when": "Precise comparison matters more than shape."
      }
    ]
  },
  "a11y": {
    "builtIn": [
      "A \"Show as table\" button shows the same data as a table, which screen readers get by default."
    ],
    "youProvide": [
      "A title that says what the figure is."
    ]
  },
  "related": [
    "bar-chart"
  ],
  "genui": {
    "expose": false
  },
  "source": [
    "src/charts/more-charts.tsx"
  ],
  "props": {
    "RadarChart": [
      {
        "name": "tableView",
        "type": "ChartTableView",
        "required": false,
        "origin": "own",
        "description": "How the data is offered as a table. `swap` (default): a toggle at the end of the chart's top row turns the plot\ninto the table at the same height, scrolling inside, so the card never grows. `hidden`: no toggle; the table is\nthere for screen readers only. `none`: no table at all, for a chart that is already text (BarList).",
        "schema": {
          "type": "string",
          "enum": [
            "hidden",
            "none",
            "swap"
          ]
        }
      },
      {
        "name": "isTableOpen",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "description": "The table is showing (`swap`), controlled; or `defaultTableOpen` + `onTableOpenChange`.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "defaultTableOpen",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "onTableOpenChange",
        "type": "(isOpen: boolean) => void",
        "required": false,
        "origin": "own"
      },
      {
        "name": "title",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "What the chart shows, over it; leave it out when a card or a heading already says so.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "aria-label",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "Names the chart when it has no visible `title` (a card's heading already says what it shows).",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "period",
        "type": "string",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "isLoading",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "emptyState",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own",
        "description": "Shown instead of the plot when there is no data: an `EmptyState size=\"small\"` or text; \"No data\" by default."
      },
      {
        "name": "height",
        "type": "number",
        "required": false,
        "origin": "own",
        "default": "280",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "data",
        "type": "readonly T[]",
        "required": true,
        "origin": "own",
        "description": "One row per dimension (five to eight).",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      {
        "name": "dimension",
        "type": "keyof T & string",
        "required": true,
        "origin": "own",
        "description": "The dimension's name key.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "categories",
        "type": "readonly (keyof T & string)[]",
        "required": true,
        "origin": "own",
        "description": "One or two profiles: the first is the main one, a second is the comparison.",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      {
        "name": "labels",
        "type": "Readonly<Partial<Record<string, string>>>",
        "required": false,
        "origin": "own"
      },
      {
        "name": "max",
        "type": "number",
        "required": true,
        "origin": "own",
        "description": "The shared scale's top.",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "valueFormatter",
        "type": "ChartValueFormatter",
        "required": false,
        "origin": "own",
        "default": "plain"
      }
    ]
  },
  "tokens": [
    "ds-background-neutral",
    "ds-background-neutral-pressed",
    "ds-background-neutral-subtle-hovered",
    "ds-background-selected",
    "ds-border",
    "ds-border-bold",
    "ds-border-focused",
    "ds-chart-1",
    "ds-chart-2",
    "ds-chart-3",
    "ds-chart-4",
    "ds-chart-5",
    "ds-chart-neutral",
    "ds-icon",
    "ds-icon-brand",
    "ds-icon-subtle",
    "ds-radius-control-small",
    "ds-radius-full",
    "ds-radius-medium",
    "ds-radius-small",
    "ds-radius-xsmall",
    "ds-shadow-overlay",
    "ds-space-050",
    "ds-space-075",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-space-300",
    "ds-space-400",
    "ds-surface-overlay",
    "ds-surface-raised",
    "ds-text",
    "ds-text-danger",
    "ds-text-subtle",
    "ds-text-subtlest",
    "ds-text-success"
  ],
  "strings": [
    "chartCategory",
    "chartNoData",
    "chartNotes",
    "chartOther",
    "chartPeriod",
    "chartShare",
    "chartTrend",
    "chartValue",
    "gaugeTarget",
    "hideDataTable",
    "selection",
    "showDataTable",
    "sparklineSummary"
  ],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
