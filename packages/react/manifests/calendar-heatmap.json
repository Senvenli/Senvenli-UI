{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "charts",
  "status": "alpha",
  "import": "@senvenli/react/charts",
  "name": "calendar-heatmap",
  "title": "Calendar heatmap",
  "exports": [
    "CalendarHeatmap"
  ],
  "description": "A value per day over weeks, as shaded cells in a calendar grid.",
  "keywords": [
    "heatmap",
    "calendar",
    "activity",
    "daily"
  ],
  "usage": {
    "when": [
      "Daily activity over months."
    ]
  },
  "a11y": {
    "keyboard": [
      {
        "keys": "Arrow keys",
        "does": "Move between days."
      }
    ],
    "builtIn": [
      "A \"Show as table\" button shows the same data as a table, which screen readers get by default."
    ],
    "youProvide": [
      "A title that says what the figure is."
    ]
  },
  "related": [
    "tracker"
  ],
  "genui": {
    "expose": false
  },
  "source": [
    "src/charts/list-charts.tsx"
  ],
  "props": {
    "CalendarHeatmap": [
      {
        "name": "title",
        "type": "string",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "period",
        "type": "string",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "isLoading",
        "type": "boolean",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "emptyMessage",
        "type": "{ title: string; description?: string | undefined; }",
        "required": false
      },
      {
        "name": "data",
        "type": "readonly CalendarHeatmapDatum[]",
        "required": true
      },
      {
        "name": "start",
        "type": "ChartDay",
        "required": false,
        "description": "The first and last day drawn; the data's range by default."
      },
      {
        "name": "end",
        "type": "ChartDay",
        "required": false
      },
      {
        "name": "thresholds",
        "type": "readonly [number, number, number, number]",
        "required": false,
        "description": "Four ascending lower bounds of the four intensity steps; from the data's quartiles by default."
      },
      {
        "name": "valueFormatter",
        "type": "ChartValueFormatter",
        "required": false,
        "default": "plain"
      },
      {
        "name": "onDayPress",
        "type": "(day: { date: CalendarDate; value: number | undefined; }) => void",
        "required": false
      }
    ]
  },
  "tokens": [
    "ds-background-brand-subtle",
    "ds-background-neutral",
    "ds-background-neutral-pressed",
    "ds-background-selected-hovered",
    "ds-background-selected-pressed",
    "ds-border",
    "ds-border-bold",
    "ds-border-focused",
    "ds-chart-1",
    "ds-chart-2",
    "ds-chart-3",
    "ds-chart-4",
    "ds-chart-5",
    "ds-chart-neutral",
    "ds-icon-danger",
    "ds-icon-success",
    "ds-icon-warning",
    "ds-link",
    "ds-radius-medium",
    "ds-radius-small",
    "ds-radius-xsmall",
    "ds-shadow-overlay",
    "ds-space-050",
    "ds-space-075",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-space-300",
    "ds-space-400",
    "ds-surface-overlay",
    "ds-surface-raised",
    "ds-text",
    "ds-text-danger",
    "ds-text-subtle",
    "ds-text-subtlest",
    "ds-text-success"
  ],
  "strings": [
    "chartBand",
    "chartCategory",
    "chartConversion",
    "chartNoData",
    "chartOther",
    "chartPeriod",
    "chartShare",
    "chartStatus",
    "chartTrend",
    "chartValue",
    "gaugeTarget",
    "heatmapLess",
    "heatmapMore",
    "hideDataTable",
    "showAll",
    "showDataTable",
    "showFewer",
    "sparklineSummary"
  ],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
