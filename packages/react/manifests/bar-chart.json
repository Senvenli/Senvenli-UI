{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "charts",
  "status": "alpha",
  "import": "@senvenli/react/charts",
  "name": "bar-chart",
  "title": "Bar chart",
  "exports": [
    "BarChart"
  ],
  "description": "Values per category or period as bars, grouped or stacked, vertical or horizontal.",
  "keywords": [
    "chart",
    "bar",
    "column",
    "compare",
    "stacked",
    "waterfall",
    "bridge",
    "variance"
  ],
  "usage": {
    "when": [
      "Comparing values across categories or periods.",
      "Explaining a change between two totals."
    ],
    "instead": [
      {
        "use": "bar-list",
        "when": "A ranked list of names with values reads better."
      }
    ]
  },
  "a11y": {
    "keyboard": [
      {
        "keys": "Arrow left / right",
        "does": "Moves between data points; the tooltip follows."
      }
    ],
    "builtIn": [
      "A \"Show as table\" button shows the same data as a table, which screen readers get by default."
    ],
    "youProvide": [
      "A title that says what the figure is."
    ]
  },
  "related": [
    "bar-list"
  ],
  "genui": {
    "expose": true,
    "description": "Values per category. Rows are categories or periods; categories are the numeric columns (a stack holds at most five).",
    "props": [
      "title",
      "period",
      "data",
      "index",
      "categories"
    ],
    "children": "none",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "What the chart shows (\"Revenue\")."
        },
        "period": {
          "type": "string",
          "description": "The period it covers (\"June–September 2026\")."
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        "index": {
          "type": "string",
          "description": "The x key: the period or category of each row."
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The series keys, in order; the first is the product's own figure (`ds-chart-1`)."
        }
      },
      "required": [
        "title",
        "data",
        "index",
        "categories"
      ]
    }
  },
  "source": [
    "src/charts/core-charts.tsx"
  ],
  "props": {
    "BarChart": [
      {
        "name": "title",
        "type": "string",
        "required": true,
        "origin": "own",
        "description": "What the chart shows (\"Revenue\").",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "period",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "The period it covers (\"June–September 2026\").",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "total",
        "type": "React.ReactNode",
        "required": false,
        "origin": "own",
        "description": "The headline figure, in `metric-medium` (\"€ 184,2k\")."
      },
      {
        "name": "data",
        "type": "readonly T[]",
        "required": true,
        "origin": "own",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        }
      },
      {
        "name": "index",
        "type": "keyof T & string",
        "required": true,
        "origin": "own",
        "description": "The x key: the period or category of each row.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "categories",
        "type": "readonly (keyof T & string)[]",
        "required": true,
        "origin": "own",
        "description": "The series keys, in order; the first is the product's own figure (`ds-chart-1`).",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      {
        "name": "labels",
        "type": "Readonly<Partial<Record<string, string>>>",
        "required": false,
        "origin": "own",
        "description": "Series names by key (\"web\" → \"Website\"); the key by default."
      },
      {
        "name": "valueFormatter",
        "type": "ChartValueFormatter",
        "required": false,
        "origin": "own",
        "description": "Shared by axis, tooltip and table (Intl): \"€ 48.920\"."
      },
      {
        "name": "indexFormatter",
        "type": "(value: unknown) => string",
        "required": false,
        "origin": "own",
        "description": "The index label in the tooltip and the table (\"August 2026\")."
      },
      {
        "name": "indexLabel",
        "type": "string",
        "required": false,
        "origin": "own",
        "description": "The index column's header in the data table; \"Period\" for time charts, \"Category\" for BarChart.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "height",
        "type": "number",
        "required": false,
        "origin": "own",
        "description": "The plot's height in px; 240 by default.",
        "schema": {
          "type": "number"
        }
      },
      {
        "name": "isLoading",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "emptyMessage",
        "type": "{ title: string; description?: string | undefined; }",
        "required": false,
        "origin": "own",
        "description": "Shown instead of the plot when `data` is empty; \"No data for this period\" by default."
      },
      {
        "name": "allowDecimals",
        "type": "boolean",
        "required": false,
        "origin": "own",
        "description": "`false` for whole counts (orders, new customers): the value axis steps by whole numbers, so a small count\nreads 0 / 1 / 2 / 3, never 0.7 / 1.4 / 2.1. Fractional steps by default. Percent bars keep their\n0–100% steps.",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "type",
        "type": "\"percent\" | \"grouped\" | \"stacked\"",
        "required": false,
        "origin": "own",
        "description": "`grouped` periods side by side, `stacked` parts of a whole, `percent` parts as shares.",
        "schema": {
          "type": "string",
          "enum": [
            "percent",
            "grouped",
            "stacked"
          ]
        }
      },
      {
        "name": "layout",
        "type": "\"horizontal\" | \"vertical\"",
        "required": false,
        "origin": "own",
        "description": "`horizontal` for long category names, ranked; `vertical` columns by default.",
        "schema": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical"
          ]
        }
      },
      {
        "name": "comparison",
        "type": "keyof T & string",
        "required": false,
        "origin": "own",
        "description": "A comparison series (last year): `ds-chart-neutral`.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "sortBy",
        "type": "\"none\" | \"value\"",
        "required": false,
        "origin": "own",
        "description": "Horizontal bars are sorted by their total unless the categories have a natural order (`none`).",
        "schema": {
          "type": "string",
          "enum": [
            "none",
            "value"
          ]
        }
      },
      {
        "name": "referenceLines",
        "type": "readonly ChartReferenceLine[]",
        "required": false,
        "origin": "own",
        "description": "An average or target line.",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "number"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "label"
            ]
          }
        }
      }
    ]
  },
  "tokens": [
    "ds-background-neutral",
    "ds-border",
    "ds-border-bold",
    "ds-border-focused",
    "ds-chart-1",
    "ds-chart-2",
    "ds-chart-3",
    "ds-chart-4",
    "ds-chart-5",
    "ds-chart-neutral",
    "ds-link",
    "ds-radius-medium",
    "ds-radius-small",
    "ds-radius-xsmall",
    "ds-shadow-overlay",
    "ds-space-050",
    "ds-space-075",
    "ds-space-100",
    "ds-space-150",
    "ds-space-200",
    "ds-space-300",
    "ds-surface-overlay",
    "ds-surface-raised",
    "ds-text",
    "ds-text-danger",
    "ds-text-subtle",
    "ds-text-subtlest",
    "ds-text-success"
  ],
  "strings": [
    "chartCategory",
    "chartNoData",
    "chartPeriod",
    "hideDataTable",
    "showDataTable"
  ],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
