{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "feedback",
  "status": "alpha",
  "import": "@senvenli/react/feedback",
  "name": "status-dot",
  "title": "Status dot",
  "exports": [
    "StatusDot"
  ],
  "description": "A small colored dot with a word for a live system state: online, syncing, offline.",
  "keywords": [
    "status",
    "presence",
    "online",
    "indicator",
    "live"
  ],
  "usage": {
    "when": [
      "Showing a live state of a connection or system."
    ],
    "instead": [
      {
        "use": "lozenge",
        "when": "The status belongs to a record (order, invoice)."
      }
    ]
  },
  "a11y": {
    "builtIn": [
      "The word carries the state; the color never does alone."
    ],
    "youProvide": [
      "A status word, or an `aria-label` when there is no visible word."
    ]
  },
  "related": [
    "lozenge"
  ],
  "genui": {
    "expose": true,
    "description": "A dot with a word for a live state (online, syncing). Use lozenge for a record's status.",
    "props": [
      "tone",
      "isLive"
    ],
    "children": "text",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone": {
          "type": "string",
          "enum": [
            "danger",
            "neutral",
            "warning",
            "success",
            "information"
          ]
        },
        "isLive": {
          "type": "boolean",
          "description": "A 3px halo for a state that is active right now (connected, syncing)."
        }
      }
    }
  },
  "source": [
    "src/feedback/status-dot.tsx"
  ],
  "props": {
    "StatusDot": [
      {
        "name": "tone",
        "type": "StatusDotTone",
        "required": false,
        "default": "\"neutral\"",
        "schema": {
          "type": "string",
          "enum": [
            "danger",
            "neutral",
            "warning",
            "success",
            "information"
          ]
        }
      },
      {
        "name": "isLive",
        "type": "boolean",
        "required": false,
        "description": "A 3px halo for a state that is active right now (connected, syncing).",
        "schema": {
          "type": "boolean"
        }
      },
      {
        "name": "children",
        "type": "React.ReactNode",
        "required": false,
        "description": "The word: the colour never carries the state alone."
      },
      {
        "name": "aria-label",
        "type": "string",
        "required": false,
        "description": "Only where a visible word is impossible (a dense table cell with its own column header).",
        "schema": {
          "type": "string"
        }
      }
    ]
  },
  "tokens": [
    "ds-background-danger",
    "ds-background-information",
    "ds-background-neutral",
    "ds-background-success",
    "ds-background-warning",
    "ds-icon-danger",
    "ds-icon-information",
    "ds-icon-subtle",
    "ds-icon-success",
    "ds-icon-warning",
    "ds-radius-full",
    "ds-space-075",
    "ds-space-100",
    "ds-text"
  ],
  "strings": [],
  "quality": {
    "tests": true,
    "a11y": false,
    "docs": false,
    "visual": false,
    "dark": false,
    "rtl": false,
    "mcp": true,
    "generic": true
  }
}
