{
  "$schema": "https://design.senvenli.com/schema/component.full.json",
  "kind": "component",
  "family": "form",
  "status": "alpha",
  "import": "@senvenli/react/form",
  "name": "number-field",
  "title": "Number field",
  "exports": [
    "NumberField"
  ],
  "description": "A locale-aware number input with steppers, ranges, units and currency.",
  "keywords": [
    "number",
    "quantity",
    "currency",
    "amount",
    "stepper"
  ],
  "usage": {
    "when": [
      "Entering a number: a quantity, a price, a percentage."
    ]
  },
  "a11y": {
    "keyboard": [
      {
        "keys": "Arrow up / down",
        "does": "Increments or decrements by the step."
      }
    ],
    "builtIn": [
      "Steppers are named \"Increase\" and \"Decrease\".",
      "Formats and parses in the user's locale."
    ],
    "youProvide": [
      "The range in the label or description."
    ]
  },
  "related": [
    "text-field"
  ],
  "genui": {
    "expose": true,
    "description": "A number input. Set minValue and maxValue when the range is known. Emits change.",
    "props": [
      "label",
      "description",
      "minValue",
      "maxValue",
      "step",
      "isRequired"
    ],
    "children": "none",
    "events": [
      "change"
    ],
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "minValue": {
          "type": "number",
          "description": "The smallest value allowed for the input."
        },
        "maxValue": {
          "type": "number",
          "description": "The largest value allowed for the input."
        },
        "step": {
          "type": "number",
          "description": "The amount that the input value changes with each increment or decrement \"tick\"."
        },
        "isRequired": {
          "type": "boolean",
          "description": "Whether user input is required on the input before form submission."
        }
      },
      "required": [
        "label"
      ]
    }
  },
