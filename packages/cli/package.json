{
  "name": "@senvenli/cli",
  "version": "0.3.14",
  "description": "Write Senvenli UI theme files from a preset code or options.",
  "license": "MIT",
  "author": "Senvenli",
  "homepage": "https://design.senvenli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senvenli/Senvenli-UI.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/Senvenli/Senvenli-UI/issues",
  "keywords": [
    "design-system",
    "theme",
    "cli",
    "tailwindcss",
    "wcag"
  ],
  "type": "module",
  "bin": {
    "senvenli-ui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@senvenli/tokens": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
