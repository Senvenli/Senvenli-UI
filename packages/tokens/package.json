{
  "name": "@senvenli/tokens",
  "version": "0.3.1",
  "description": "Platform-neutral theme engine for Senvenli UI: a few optional inputs to a full, WCAG AA token set for web (CSS) and native apps (hex).",
  "license": "MIT",
  "author": "Senvenli",
  "homepage": "https://design.senvenli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senvenli/Senvenli-UI.git",
    "directory": "packages/tokens"
  },
  "bugs": "https://github.com/Senvenli/Senvenli-UI/issues",
  "keywords": [
    "design-tokens",
    "theme",
    "wcag",
    "contrast",
    "oklch",
    "design-system"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
