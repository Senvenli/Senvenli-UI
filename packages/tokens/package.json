{
  "name": "@senvenli/tokens",
  "version": "0.0.0",
  "description": "Platform-neutral theme engine for Senvenli UI: a few optional inputs to a full, WCAG AA token set for web and React Native.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
