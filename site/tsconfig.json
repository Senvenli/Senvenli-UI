{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@senvenli/tokens": [
        "../packages/tokens/src/index.ts"
      ],
      "@senvenli/react": [
        "../packages/react/src/index.ts"
      ],
      "@senvenli/react/display": [
        "../packages/react/src/display/index.ts"
      ],
      "@senvenli/react/action": [
        "../packages/react/src/action/index.ts"
      ],
      "@senvenli/react/layout": [
        "../packages/react/src/layout/index.ts"
      ],
      "@senvenli/react/feedback": [
        "../packages/react/src/feedback/index.ts"
      ],
      "@senvenli/react/form": [
        "../packages/react/src/form/index.ts"
      ],
      "@senvenli/react/selection": [
        "../packages/react/src/selection/index.ts"
      ],
      "@senvenli/react/overlay": [
        "../packages/react/src/overlay/index.ts"
      ],
      "@senvenli/react/navigation": [
        "../packages/react/src/navigation/index.ts"
      ]
    },
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
