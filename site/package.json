{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve-static.mjs build/client 5181",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "pnpm -w exec vitest run --config site/vitest.config.ts --exclude 'tests/build/**'",
    "test:build": "pnpm -w exec vitest run --config site/vitest.config.ts tests/build",
    "check:hydration": "sh scripts/build-all.sh"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@react-router/node": "8.5.2",
    "@senvenli/react": "workspace:*",
    "@senvenli/tokens": "workspace:*",
    "lucide-react": "1.34.0",
    "react": "^19",
    "react-aria-components": "1.21.1",
    "react-dom": "^19",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "marked": "18.1.3",
    "shiki": "4.6.0",
    "tailwindcss": "^4.3.2",
    "vite": "^7.3.6"
  }
}
